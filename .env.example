# ---------------------------------------------------------------------------
# bank-statement-analizer — environment variables
#
# Copy this file to .env and fill in the values you need.  Only
# ANTHROPIC_API_KEY is strictly required to run the service; every other
# variable has a documented default.
#
# DO NOT commit .env.  It is listed in .gitignore.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Model API keys (REQUIRED)
# ---------------------------------------------------------------------------

# Anthropic Claude API key.  Required.  The graph uses Haiku 4.5 for
# classification, routing and critic, and Sonnet 4.6 for transaction
# extraction; both are billed against this key.
# Obtain one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME


# ---------------------------------------------------------------------------
# LangSmith tracing (OPTIONAL)
# ---------------------------------------------------------------------------

# LangSmith API key.  Optional.  When LANGSMITH_TRACING=true, every LangGraph
# run and every LLM call is reported to the LangSmith project named below.
# Obtain one at: https://smith.langchain.com/
LANGSMITH_API_KEY=lsv2_pt_REPLACE_ME

# LangSmith project name.  Optional.  Defaults to "bank-statement" in code;
# the bundled docker-compose overrides it to "bank-statement-analizer-dev".
LANGSMITH_PROJECT=bank-statement

# Enable or disable tracing.  Accepts "true"/"false".  Defaults to "false".
# Set to "true" once LANGSMITH_API_KEY is configured.
LANGSMITH_TRACING=false

# LangSmith API endpoint.  Optional.  Override only if you self-host or use
# a regional LangSmith endpoint.  Defaults to https://api.smith.langchain.com.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com


# ---------------------------------------------------------------------------
# CORS (OPTIONAL)
# ---------------------------------------------------------------------------

# Origin allowed by the FastAPI CORS middleware.  Optional.
# Defaults to http://localhost (compose) / http://localhost:5173 (local dev).
# Set to the public URL of the deployed frontend in production.
FRONTEND_ORIGIN=http://localhost


# ---------------------------------------------------------------------------
# OCR engine — Azure Document Intelligence (OPTIONAL)
# ---------------------------------------------------------------------------
# When BOTH variables below are set the ingest node prefers Azure Document
# Intelligence over the bundled self-hosted Tesseract / ocrmypdf fallback for
# image-based PDFs.  Azure DI gives noticeably better digit recognition on
# noisy scans; Tesseract is the default and requires no external service.
# Obtain credentials at: https://portal.azure.com/ → Document Intelligence.

# Azure Document Intelligence endpoint URL.  Optional.
AZURE_DI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# Azure Document Intelligence API key.  Optional.
AZURE_DI_KEY=REPLACE_ME


# ---------------------------------------------------------------------------
# LangGraph checkpointer (OPTIONAL)
# ---------------------------------------------------------------------------

# Checkpointer backend.  Optional.  Accepts "sqlite" (default) or "memory"
# (in-process, no persistence — useful for unit tests).  The bundled service
# only ships sqlite and memory backends; a "postgres" extra is declared in
# pyproject.toml for users who want to wire their own PostgresSaver.
LANGGRAPH_CHECKPOINTER=sqlite

# Filesystem path for the SQLite checkpoint database.  Optional.
# Defaults to ./graph.sqlite.  The Docker image writes to /app/data/graph.sqlite
# on a named volume so checkpoints survive container restarts.
LANGGRAPH_SQLITE_PATH=./graph.sqlite

# Postgres connection string.  Optional and only consumed when you wire a
# PostgresSaver yourself (the bundled sqlite/memory backends ignore it).
# Format: postgresql://user:pass@host:5432/dbname
# DATABASE_URL=postgresql://user:pass@localhost:5432/bsa


# ---------------------------------------------------------------------------
# Cost ceiling & human-in-the-loop (OPTIONAL)
# ---------------------------------------------------------------------------

# Hard cumulative LLM-cost ceiling per request, in USD.  Optional.
# Defaults to 5.00.  When the running cost crosses this threshold the graph
# stops retrying through the critic loop and routes to human review instead.
BSA_COST_CAP_USD=5.00

# Suspect-count threshold above which the graph pauses for human review
# instead of running the critic loop.  Optional.  Defaults to 3 in code; the
# bundled docker-compose raises it to 25 to give the critic a chance on the
# 10-period Ixonia bundle.  Set to 0 to force every non-clean run to pause.
BSA_AWAIT_REVIEW_SUSPECTS=3



# ---------------------------------------------------------------------------
# Logging & runtime paths (OPTIONAL)
# ---------------------------------------------------------------------------

# Application log level.  Optional.  Accepts the standard Python levels
# (DEBUG, INFO, WARNING, ERROR, CRITICAL).  Defaults to INFO.
LOG_LEVEL=INFO

# Filesystem path for the pending-reviews SQLite store.  Optional.
# Defaults to ./reviews.sqlite in local dev; the Docker image stores it at
# /app/data/reviews.sqlite on the persisted volume.
# REVIEWS_DB_PATH=./reviews.sqlite


# Restrict msgpack deserialisation to the safe allow-list.  Optional.
# Defaults to "true" and you should leave it that way: setting it to "false"
# allows arbitrary Python objects to be deserialised from the checkpoint
# database, which is a code-execution risk if the DB ever takes untrusted
# input.  Exposed only so test harnesses can flip it locally.
# LANGGRAPH_STRICT_MSGPACK=true
